---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Page not found',
    description:
      'The requested page is unavailable. Start from the SDK documentation home.',
    pagefind: false,
  }}
>
  <p>The page you are looking for could not be found.</p>
  <p>
    <a href={import.meta.env.BASE_URL}>Go back to the documentation home</a>.
  </p>
</StarlightPage>
