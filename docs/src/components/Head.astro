---
import '@fontsource-variable/geist/wght.css';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist-mono/wght.css';

const { head, id, entry } = Astro.locals.starlightRoute;
const isRestOperation = id.startsWith('rest-api/');
const title =
  Astro.url.pathname === import.meta.env.BASE_URL || id === 'rest-api'
    ? entry.data.title
    : isRestOperation
      ? `${entry.data.title} – Milvus REST API`
      : undefined;
---

{
  head.map(({ tag: Tag, attrs, content }) => {
    if (title && Tag === 'title') return <title>{title}</title>;
    if (title && Tag === 'meta' && attrs?.property === 'og:title')
      return <meta property="og:title" content={title} />;
    return <Tag {...attrs} set:html={content} />;
  })
}
{(id === 'rest-api' || isRestOperation) && <ClientRouter fallback="swap" />}
<script is:inline>
  // GA4 Enhanced Measurement records Astro's history navigation automatically.
  if (!window.gtag) {
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () {
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', 'G-HLMZXDSQYF');
  }
</script>
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=G-HLMZXDSQYF"></script>
