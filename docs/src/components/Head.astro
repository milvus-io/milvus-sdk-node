---
import '@fontsource-variable/geist/wght.css';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/geist-mono/wght.css';

const { head, id } = Astro.locals.starlightRoute;
const isRest = id === 'rest-api' || id.startsWith('rest-api/');
---

{
  head.map(({ tag: Tag, attrs, content }) => (
    <Tag {...attrs} set:html={content} />
  ))
}
{
  isRest ? (
    <ClientRouter fallback="swap" />
  ) : (
    <>
      <script
        is:inline
        async
        src="https://www.googletagmanager.com/gtag/js?id=G-HLMZXDSQYF"
      />
      <script
        is:inline
        set:html={`
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());
  gtag('config', 'G-HLMZXDSQYF');
`}
      />
    </>
  )
}
