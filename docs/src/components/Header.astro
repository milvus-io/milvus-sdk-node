---
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref } = Astro.locals.starlightRoute;
const links = [
  ['Guides', '/getting-started/getting-started', 'guides'],
  ['SDK Reference', '/api-reference', 'api-reference'],
  ['REST API', '/rest-api', 'rest-api'],
];
const section = Astro.url.pathname.slice(base.length).split('/')[1];
---

<div class="docs-header">
  <a class="brand" href={siteTitleHref}
    ><img src={base + '/milvus-logo.svg'} alt="Milvus" width="96" height="22" />
    <span>Node SDK</span></a
  >
  <nav aria-label="Documentation">
    {
      links.map(([label, href, group]) => (
        <a
          href={base + href}
          aria-current={
            group === section ||
            (group === 'guides' &&
              !['api-reference', 'rest-api'].includes(section))
              ? 'true'
              : undefined
          }
        >
          {label}
        </a>
      ))
    }
  </nav>
  <Search />
  <div class="desktop-theme"><ThemeSelect /></div>
</div>

<style>
  .docs-header,
  nav {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 2vw, 1.4rem);
  }
  nav {
    margin-inline-end: auto;
  }
  .docs-header {
    height: 100%;
  }
  a {
    color: var(--sl-color-text);
    text-decoration: none;
    white-space: nowrap;
    font-size: 0.875rem;
  }
  a:hover,
  a[aria-current] {
    color: var(--sl-color-text-accent);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .brand span {
    font-weight: 500;
  }
  @media (max-width: 49.99rem) {
    .docs-header {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-rows: 2.65rem auto;
      gap: 0;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    nav a {
      padding-block: 0.2rem;
    }
    .docs-header :global(button[data-open-modal]) {
      font-size: 0.875rem;
    }
    .docs-header :global(button[data-open-modal] span) {
      display: inline;
    }
    .desktop-theme {
      display: none;
    }
  }
</style>
