---
import { Icon } from '@astrojs/starlight/components';
import Search from 'virtual:starlight/components/Search';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { siteTitleHref, hasSidebar } = Astro.locals.starlightRoute;
const section = Astro.url.pathname.slice(base.length).split('/')[1];
const links = [
  ['Guides', '/getting-started/getting-started', 'guides'],
  ['SDK Reference', '/api-reference', 'api-reference'],
  ['REST API', '/rest-api', 'rest-api'],
].map(([label, href, group]) => ({
  label,
  href: base + href,
  current:
    group === section ||
    (group === 'guides' && !['api-reference', 'rest-api'].includes(section)),
}));
---

<div class="docs-header">
  <a class="brand" href={siteTitleHref}
    ><img src={base + '/milvus-logo.svg'} alt="Milvus" width="91" height="21" />
    <span>Node SDK</span></a
  >
  <nav class="desktop-navigation" aria-label="Documentation">
    {
      links.map(({ label, href, current }) => (
        <a href={href} aria-current={current ? 'true' : undefined}>
          {label}
        </a>
      ))
    }
  </nav>
  <div class="header-tools">
    <details class="mobile-sections">
      <summary>Sections <Icon name="down-caret" size="0.95rem" /></summary>
      <nav aria-label="Documentation">
        {
          links.map(({ label, href, current }) => (
            <a href={href} aria-current={current ? 'true' : undefined}>
              {label}
            </a>
          ))
        }
        {!hasSidebar && <ThemeSelect />}
      </nav>
    </details>
    <Search />
    <a
      class="github-link"
      href="https://github.com/milvus-io/milvus-sdk-node"
      aria-label="Milvus Node.js SDK on GitHub"
    >
      <Icon name="github" size="1.125rem" />
    </a>
    <div class="desktop-theme"><ThemeSelect /></div>
  </div>
</div>

<script>
  const sections =
    document.querySelector<HTMLDetailsElement>('.mobile-sections');

  document.addEventListener('pointerdown', (event) => {
    if (sections?.open && !event.composedPath().includes(sections)) {
      sections.open = false;
    }
  });

  sections?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && sections.open) {
      sections.open = false;
      sections.querySelector('summary')?.focus();
    }
  });
</script>

<style>
  .docs-header,
  .desktop-navigation,
  .header-tools {
    display: flex;
    align-items: center;
  }

  .docs-header {
    height: 100%;
    gap: 1.75rem;
  }

  .desktop-navigation {
    align-self: stretch;
    gap: clamp(0.8rem, 1.6vw, 1.375rem);
    margin-inline-end: auto;
  }

  a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    white-space: nowrap;
  }

  .desktop-navigation a {
    display: grid;
    place-items: center;
    border-bottom: 2px solid transparent;
    font-size: 0.8125rem;
    font-weight: 500;
  }

  a:hover,
  a[aria-current] {
    color: var(--sl-color-text-accent);
  }

  .desktop-navigation a[aria-current] {
    border-bottom-color: var(--docs-brand);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--sl-color-white);
  }

  .brand span {
    padding-inline-start: 0.65rem;
    border-inline-start: 1px solid var(--sl-color-hairline);
    font-size: 0.8125rem;
    font-weight: 550;
  }

  .header-tools {
    gap: 0.75rem;
  }

  .github-link {
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    min-height: 2rem;
  }

  .mobile-sections {
    display: none;
  }

  @media (max-width: 49.99rem) {
    .docs-header {
      justify-content: space-between;
      gap: 0.6rem;
    }

    .header-tools {
      gap: 0.35rem;
    }

    .mobile-sections {
      position: relative;
      display: block;
    }

    .mobile-sections summary {
      display: flex;
      align-items: center;
      min-height: 2rem;
      gap: 0.2rem;
      padding-inline: 0.45rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.45rem;
      background: var(--docs-surface);
      color: var(--sl-color-gray-3);
      font-size: 0.8125rem;
      cursor: pointer;
      list-style: none;
    }

    .mobile-sections summary::-webkit-details-marker {
      display: none;
    }

    .mobile-sections[open] summary {
      color: var(--sl-color-text-accent);
    }

    .mobile-sections nav {
      position: absolute;
      inset-block-start: calc(100% + 0.55rem);
      inset-inline-end: 0;
      min-width: 10rem;
      padding: 0.375rem;
      border: 1px solid var(--sl-color-hairline);
      border-radius: 0.5rem;
      background: var(--sl-color-bg);
      box-shadow: var(--sl-shadow-md);
      font-size: var(--sl-text-sm);
    }

    .mobile-sections a {
      display: block;
      padding: 0.4rem 0.55rem;
      border-radius: 0.35rem;
    }

    .mobile-sections a[aria-current] {
      background: var(--sl-color-accent-low);
    }

    .mobile-sections :global(starlight-theme-select) {
      display: block;
      margin: 0.3rem 0.55rem;
    }

    .desktop-navigation,
    .github-link,
    .desktop-theme {
      display: none;
    }
  }

  @media (max-width: 22rem) {
    .brand span {
      display: none;
    }
  }
</style>
