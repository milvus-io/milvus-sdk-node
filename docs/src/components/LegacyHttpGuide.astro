---
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/advanced/http-client`;
---

<p>
  This guide has moved. <a id="http-guide-link" href={href}
    >Open the HTTP client guide</a
  >.
</p>

<script>
  const guide = document.querySelector<HTMLAnchorElement>('#http-guide-link');
  if (guide) window.location.replace(guide.href + window.location.hash);
</script>
