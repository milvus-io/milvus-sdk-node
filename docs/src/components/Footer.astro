---
import EditLink from 'virtual:starlight/components/EditLink';
import LastUpdated from 'virtual:starlight/components/LastUpdated';
import Pagination from 'virtual:starlight/components/Pagination';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="sl-flex">
  <div class="meta sl-flex">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />

  <nav aria-label="Resources">
    <a href={`${base}/reference/additional-resources/`}>Resources</a>
    <a href={`${base}/reference/release-notes/`}>Release notes</a>
    <a href={`${base}/reference/troubleshooting/`}>Troubleshooting</a>
    <a href={`${base}/reference/migration-compatibility/`}>Compatibility</a>
    <a href={`${base}/reference/contributing/`}>Contributing</a>
    <a href={`${base}/llms.txt`} data-astro-reload>LLMs.txt</a>
    <a href="https://github.com/milvus-io/milvus-sdk-node">GitHub</a>
    <a href="https://milvus.io">Milvus</a>
    <a href="https://cloud.zilliz.com">Zilliz Cloud</a>
    <a href="https://github.com/zilliztech/attu/releases">Attu</a>
  </nav>
  <p class="copyright">
    Apache-2.0 {new Date().getFullYear()} © Milvus Node.js SDK.
  </p>
</footer>

<style>
  @layer starlight.core {
    footer {
      flex-direction: column;
      gap: 1.5rem;
    }
    .meta {
      gap: 0.75rem 3rem;
      justify-content: space-between;
      flex-wrap: wrap;
      margin-top: 3rem;
      font-size: var(--sl-text-sm);
      color: var(--sl-color-gray-3);
    }
    .meta > :global(p:only-child) {
      margin-inline-start: auto;
    }

    nav {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1rem;
      font-size: var(--sl-text-sm);
      padding-top: 0.75rem;
      border-top: 1px solid var(--sl-color-hairline);
    }
    .copyright {
      color: var(--sl-color-gray-3);
      font-size: var(--sl-text-xs);
      margin: 0 auto 1.5rem;
    }
  }
</style>
