---
import { restHref } from '../lib/rest-navigation';
import type { RestOperation } from '../lib/rest-catalog';

const { operation } = Astro.props as { operation: RestOperation };
const showCollections =
  operation.slug === 'collections/list' ||
  (operation.slug !== 'collections/create' &&
    operation.fields.some((f) => f.name === 'collectionName'));
const useDatabase = operation.fields.some((f) => f.name === 'dbName');
---

<div class="rest-connection" data-pagefind-ignore data-agent-ignore>
  <div
    class="rest-connection-fields"
    data-collection-picker={showCollections ? 'enabled' : 'hidden'}
  >
    <label>
      Endpoint
      <input
        id="rest-endpoint"
        type="url"
        placeholder="https://your-cluster.example.com"
        autocomplete="off"
      />
    </label>
    <label>
      Bearer token (optional)
      <input
        id="rest-token"
        type="password"
        autocomplete="off"
        spellcheck="false"
        autocapitalize="none"
      />
    </label>
    <label hidden={!showCollections}>
      Collection
      <select
        id="rest-collection"
        data-uses-database={String(useDatabase)}
        disabled
      >
        <option value="">Run List collections</option>
      </select>
    </label>
  </div>
  <details>
    <summary>Connection and CORS help</summary>
    <p>
      Use HTTPS for remote clusters or HTTP on loopback. Requests go directly
      from your browser to the endpoint. {
        showCollections && (
          <>
            Run <a href={restHref('collections/list')}>List collections</a> to
            populate the collection selector.
          </>
        )
      } When copying an authenticated cURL command, set <code>MILVUS_TOKEN</code
      > in your shell.
    </p>
    <p>
      For cross-origin requests, configure the endpoint to answer OPTIONS and
      allow the docs origin, POST, Content-Type, and Authorization if you use a
      token. Try the copied cURL command to troubleshoot outside the browser.
    </p>
  </details>
  <p role="status" id="rest-selection-status" hidden={!showCollections}></p>
</div>

<script>
  import '../lib/rest-browser';
</script>
