---
import { Icon } from '@astrojs/starlight/components';
import { curlCommand, requestUrl } from '../lib/rest-explorer';
import type { RestOperation } from '../lib/rest-catalog';

const { operation } = Astro.props as { operation: RestOperation };
const { slug, title, path, request, response } = operation;
const requestJson = JSON.stringify(request, null, 2);
const responseJson = JSON.stringify(response, null, 2);
const command = curlCommand(
  requestUrl('https://your-cluster.example.com', path),
  requestJson,
  true
);
const anchor = slug.replaceAll('/', '-');
---

<section
  class="rest-panel"
  data-operation={slug}
  data-route={path}
  aria-label={title}
>
  <template
    data-agent-rest
    data-route={path}
    data-example-request={requestJson}
    data-example-command={command}
    data-example-response={responseJson}></template>
  <p class="rest-route">
    <strong>POST</strong>
    <code>{path}</code>
  </p>
  <div class="rest-columns">
    <div class="rest-operation not-content" data-pagefind-ignore>
      <div class="rest-actions rest-request-heading" id="default-request">
        <label for={`rest-body-${anchor}`}>Request JSON</label>
        <div class="rest-action-buttons" data-request-actions hidden>
          <button data-copy type="button">Copy cURL</button>
          <button data-run type="button">
            Send request <Icon name="right-arrow" size="0.9rem" />
          </button>
        </div>
      </div>
      <div>
        <textarea
          id={`rest-body-${anchor}`}
          data-body
          hidden
          rows="6"
          spellcheck="false">{requestJson}</textarea
        >
        <pre
          data-static-request
          aria-label="Default request JSON"
          tabindex="0"><code>{requestJson}</code></pre>
      </div>
      {
        (slug === 'entities/query' || slug === 'entities/search') && (
          <div data-schema hidden>
            <label>
              {slug === 'entities/query'
                ? 'Output field'
                : 'Dense vector field'}
              <select data-field />
            </label>
            <button data-generate type="button">
              Apply schema field
            </button>
          </div>
        )
      }
      <p role="status" data-feedback hidden></p>
      <div class="rest-actions rest-response-heading" id="sample-response">
        <p role="status" data-status>Example response</p>
        <button data-copy-response type="button" hidden>Copy response</button>
      </div>
      <pre
        aria-label="Raw response"
        tabindex="0"
        data-response>{responseJson}</pre>
      <details id="curl-command" data-curl-example open>
        <summary>cURL command</summary>
        <pre aria-label="cURL command" tabindex="0" data-command>{command}</pre>
      </details>
    </div>
    <div class="rest-docs"><slot /></div>
  </div>
</section>
