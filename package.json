{
  "name": "@zilliz/milvus2-sdk-node",
  "author": "Zilliz",
  "milvusVersion": "v3.0.6",
  "version": "3.0.7",
  "main": "dist/milvus",
  "types": "dist/milvus/index.d.ts",
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "repository": "github:milvus-io/milvus-sdk-node",
  "scripts": {
    "pre": "git submodule update --init --recursive && rm -rf proto/proto/google && mkdir -p proto/proto/google/protobuf && cp node_modules/protobufjs/google/protobuf/descriptor.proto proto/proto/google/protobuf/descriptor.proto",
    "build": "rm -rf dist && tsc --declaration && node build.js",
    "test": "NODE_ENV=dev jest",
    "test-cloud": "NODE_ENV=dev jest --config jest.test2.cloud.config.js",
    "bench": "ts-node benchmarks/bench.ts",
    "coverage": "NODE_ENV=dev jest --coverage",
    "build-test": "npm run build && NODE_ENV=dev jest --testPathPattern=test2/package/",
    "example": "npx ts-node",
    "doc": "npm --prefix docs run build",
    "doc-json": "npx typedoc milvus --json",
    "proto:json": "ts-node scripts/generate-proto.ts",
    "doc:dev": "npm --prefix docs run dev",
    "test:unit": "NODE_ENV=dev jest --testPathPattern=test2/unit/",
    "test:e2e": "NODE_ENV=dev jest --testPathPattern=test2/e2e/",
    "test:env:up": "docker compose -f test2/environment/compose.yml up -d --wait --wait-timeout 240",
    "test:env:down": "docker compose -f test2/environment/compose.yml down",
    "coverage:check": "node scripts/check-coverage.cjs test2/coverage-baseline.json coverage/coverage-summary.json",
    "test:tooling": "node --test scripts/test-tooling.test.cjs",
    "test:integration": "NODE_ENV=dev jest --testPathPattern=test2/integration/",
    "test2": "NODE_ENV=dev jest",
    "test2:unit": "NODE_ENV=dev jest --testPathPattern=test2/unit/",
    "test2:e2e": "NODE_ENV=dev jest --testPathPattern=test2/e2e/",
    "test2:coverage": "NODE_ENV=dev jest --coverage",
    "test2:env:up": "docker compose -f test2/environment/compose.yml up -d --wait --wait-timeout 240",
    "test2:env:down": "docker compose -f test2/environment/compose.yml down",
    "test2:integration": "NODE_ENV=dev jest --testPathPattern=test2/integration/",
    "test2:package": "NODE_ENV=dev jest --testPathPattern=test2/package/",
    "test2:compare": "node scripts/check-coverage.cjs test2/coverage-baseline.json coverage/coverage-summary.json",
    "test2:audit": "node scripts/check-test2.cjs",
    "test2:cloud": "NODE_ENV=dev jest --config jest.test2.cloud.config.js",
    "test:package": "NODE_ENV=dev jest --testPathPattern=test2/package/",
    "test:audit": "node scripts/check-test2.cjs",
    "test:ci": "npm run test:audit && npm run test:tooling && npm run build && npm run coverage && npm run coverage:check"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.0",
    "@opentelemetry/api": "^1.9.0",
    "@petamoriken/float16": "^3.8.6",
    "@shanghaikid/parquetjs": "1.8.9",
    "dayjs": "^1.11.7",
    "generic-pool": "^3.9.0",
    "lru-cache": "^9.1.2",
    "protobufjs": "^7.6.3",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@babel/plugin-transform-modules-commonjs": "^7.21.5",
    "@types/jest": "^29.5.1",
    "@types/node-fetch": "^2.6.8",
    "jest": "^29.5.0",
    "long": "^5.2.3",
    "node-fetch": "2",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.1",
    "typedoc": "^0.24.7",
    "typescript": "^5.0.4"
  },
  "resolutions": {
    "**/glob/minimatch": "3.1.5",
    "**/glob/minimatch/brace-expansion": "1.1.21",
    "**/test-exclude/minimatch": "3.1.5",
    "**/test-exclude/minimatch/brace-expansion": "1.1.21",
    "**/typedoc/minimatch": "6.2.3",
    "**/@istanbuljs/load-nyc-config/js-yaml": "^4.3.1",
    "@babel/core": "^7.29.7",
    "@babel/helpers": "^7.26.10",
    "browserslist": "^4.28.7",
    "diff": "^4.0.4",
    "fast-xml-parser": "^5.12.0",
    "fast-xml-builder": "^1.2.0",
    "form-data": "^4.0.6",
    "protobufjs": "^7.6.5",
    "lodash": "^4.18.1",
    "picomatch": "^2.3.2",
    "thrift": "0.24.0",
    "thrift/uuid": "11.1.1",
    "**/jest-config/deepmerge": "npm:@shivammathur/deepmerge@4.3.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
